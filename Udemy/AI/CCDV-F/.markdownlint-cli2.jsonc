{
  "config": {
    "default": true,
    // Los apuntes tienen párrafos largos en español; no forzar wrap de línea.
    "MD013": false,
    // El formato del repo usa varios recuadros "> ⚠️/🎯/📌/💡" seguidos, separados
    // por una línea en blanco, como notas independientes (no como un único blockquote).
    "MD028": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "**/Books/**"]
}
